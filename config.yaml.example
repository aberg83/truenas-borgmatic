# Sanitized borgmatic 2.x example for the TrueNAS installation created by
# setup-borgmatic.sh. Copy this to config.yaml and replace every placeholder.
# Never commit the real config.yaml: repository addresses and monitoring URLs
# may identify your systems, and the live file is ignored by .gitignore.

# This empty list is intentional when ZFS datasets are selected exclusively by
# the org.torsion.borgmatic:backup=auto ZFS user property.
source_directories: []

repositories:
    - path: ssh://BORG_USER@BORG_HOST/./REPOSITORY_PATH
      label: offsite

local_path: /mnt/apps/borgmatic/bin/borg-wrapper.sh
# The Borg command on the host. rsync.net needs a versioned name (borg14 for
# Borg 1.4.x); BorgBase and most self-hosted servers don't need this line.
remote_path: borg14
temporary_directory: /mnt/apps/borgmatic/tmp
user_runtime_directory: /mnt/apps/borgmatic/tmp
borg_base_directory: /mnt/apps/borgmatic
# Host keys are pinned on the dataset rather than in /root, and BatchMode plus
# StrictHostKeyChecking make an unknown or changed host key fail the run
# immediately instead of hanging on a prompt. Populate ssh/known_hosts first --
# see step 3 of AFTER RUNNING in setup-borgmatic.sh.
# ServerAliveInterval sends a keepalive every 60s, so routers and firewalls
# don't drop the connection during long silent phases such as the
# server-side repository check, and a dead link fails the run after about
# 5 minutes (ServerAliveCountMax=5) instead of hanging while holding the lock.
ssh_command: ssh -i /mnt/apps/borgmatic/ssh/id_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/mnt/apps/borgmatic/ssh/known_hosts -o ServerAliveInterval=60 -o ServerAliveCountMax=5
encryption_passcommand: cat /mnt/apps/borgmatic/passphrase

# "auto" tests each chunk and only zstd-compresses data that shrinks, so
# already-compressed photos and video cost little CPU. Only new chunks are
# affected; existing archives keep their compression. Borg's default is lz4.
compression: auto,zstd

# Borg waits 1 second for the repository lock by default, so the nightly run
# fails if a manual `borgmatic list` or `mount` is holding it. Wait up to 5
# minutes instead.
lock_wait: 300

# Enable consistent snapshots of tagged ZFS datasets.
zfs: {}

keep_daily: 30
keep_weekly: 52
keep_monthly: 24
keep_yearly: 5

healthchecks:
    ping_url: https://hc-ping.com/REPLACE-WITH-YOUR-UUID
    send_logs: true
monitoring_verbosity: 1

# Retry transient network/SSH failures against the Borg host instead of
# failing the night's run. The wait grows with each retry (60s, 120s, 180s).
retries: 3
retry_wait: 60

# Consistency checks. With no checks: section, borgmatic still runs the
# repository and archives checks at most once a month, and the archives check
# covers every archive. On a large repository over SSH that can make one
# night's run take hours, and if it's still running at the next scheduled
# start, that run is skipped by the lock and healthchecks reports the missed
# ping. To spread the cost, set the frequencies explicitly and cap the
# archives check with check_last:
# checks:
#     - name: repository
#       frequency: 4 weeks
#     - name: archives
#       frequency: 8 weeks
# check_last: 3
#
# Don't add the "data" check unless you mean to download the whole repository.
# It runs `borg check --verify-data`, which in Borg 1.x reads and decrypts
# every chunk in the repository on this machine, whatever check_last says.
# Over SSH that transfers the full repository size each time it runs. The
# repository check above already verifies segment checksums on the Borg host
# without any transfer; periodic test restores cover decryption.
#
# Don't add the "spot" check here: it builds its file list from
# source_directories and doesn't run the ZFS hook, so with property-based
# dataset discovery it would compare an empty source list against a full
# archive and always fail. It also needs xxh64sum, which TrueNAS doesn't ship.
# Periodic test restores (README "Verification") cover the same ground.
